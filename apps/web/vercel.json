{
  "framework": "vite",
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "https://pgt-api.fly.dev/api/$1",
      "transforms": [
        {
          "type": "request.headers",
          "op": "set",
          "target": { "key": "x-origin-secret" },
          "args": "$ORIGIN_SECRET",
          "env": ["ORIGIN_SECRET"]
        }
      ]
    },
    { "handle": "filesystem" },
    { "src": "/((?!assets/).*)", "dest": "/index.html" }
  ]
}
